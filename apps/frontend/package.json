    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.4.1",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "dependencies": {
    "@lucide/svelte": "^0.556.0",
