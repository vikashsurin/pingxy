pingxy.com {
    request_body max_size 20MB

    # 1. MinIO API
    handle_path /storage/* {
        reverse_proxy storage:9000
    }

    # 2. MinIO Console (Admin)
    handle_path /minio-admin/* {
        reverse_proxy storage:9001
    }

    # 3. Backend API & WS
    handle /api* {
        reverse_proxy backend:3000
    }

    handle /ws* {
        reverse_proxy backend:3000
    }

    # 4. Frontend
    handle {
        reverse_proxy frontend:5173
    }

    # Optional: Force HTTPS and add security headers
    header {
        Strict-Transport-Security "max-age=31536000;"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
    }
}