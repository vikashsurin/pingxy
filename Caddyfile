:80 {
    request_body max_size 20MB

    # 1. MinIO API (The actual file data)
    # We use 'handle_path' to automatically strip the prefix
    handle_path /storage/* {
        reverse_proxy storage:9000
    }

    # 2. MinIO Console (The Admin UI)
    # MinIO Console needs specific websocket support and header pass-through
    handle_path /minio-admin/* {
        reverse_proxy storage:9001
    }

    # 3. Backend API & WebSockets
    # Grouping these ensures all /api and /ws calls hit the Bun backend
    handle /api* {
        reverse_proxy backend:3000
    }

    handle /ws* {
        reverse_proxy backend:3000
    }

    # 4. Frontend (SvelteKit)
    # Handle HMR and then a fallback for all other routes
    handle /_svelte_kit_hmr* {
        reverse_proxy frontend:3001
    }

    handle {
        reverse_proxy frontend:3001
    }
}