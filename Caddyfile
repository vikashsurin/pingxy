:80 {
    request_body max_size 20MB

    # 1. Storage API (Stripping /storage/ so MinIO sees /bucket/file)
    handle_path /storage/* {
        reverse_proxy storage:9000
    }

    # 2. MinIO Console UI
    handle_path /minio-admin/* {
        reverse_proxy storage:9001
    }

    # 3. Backend API (On port 3000)
    handle /api* {
        reverse_proxy backend:3000
    }

    # 4. WebSockets (Crucial for Bun/Node real-time apps)
    handle /ws* {
        reverse_proxy backend:3000
    }

    # 5. Frontend (Vite/SvelteKit on port 5173)
    handle /_svelte_kit_hmr* {
        reverse_proxy frontend:5173
    }

    handle {
        reverse_proxy frontend:5173
    }
}