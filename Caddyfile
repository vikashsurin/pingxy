:80 {
    # 1. API requests -> backend (Bun/Hono)
    handle_path /api* {
        reverse_proxy localhost:3000
    }

    # 2. Storage (MinIO)
    # This replaces your /storage/ logic and maps it to the bucket
    handle_path /storage/* {
        reverse_proxy localhost:9000 {
            # Rewrites the path to include your bucket name 'pingxy'
            rewrite /pingxy{path}
        }
    }

    # 3. WebSockets & HMR
    # Caddy detects WebSockets automatically, so no special config needed!
    # We just need to ensure the /_svelte_kit_hmr goes to the frontend
    reverse_proxy /_svelte_kit_hmr localhost:5173

    # 4. Frontend (SvelteKit)
    # 'handle' acts as a catch-all for everything else
    handle {
        reverse_proxy localhost:5173
    }

    # Global Options
    log {
        output file /var/log/caddy/access.log
    }
}
