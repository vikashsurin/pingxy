:80 {
    request_body max_size 20MB

    # 1. Storage API (Stripping /storage/ so MinIO sees /bucket/file)
    handle_path /storage/* {
        reverse_proxy storage:9000
    }

    # 2. MinIO Console UI
    handle_path /minio-admin/* {
        reverse_proxy storage:9001
    }

    # 3. Backend API (on port 3000)
    handle /api* {
        reverse_proxy backend:3000
    }

    # 4. WebSockets (backend real-time)
    handle /ws* {
        reverse_proxy backend:3000
    }

    # 5. Next.js HMR websocket (hot reload in dev)
    handle /_next/webpack-hmr* {
        reverse_proxy frontend:3001
    }

    # 6. Next.js static assets
    handle /_next/* {
        reverse_proxy frontend:3001
    }

    # 7. Frontend (Next.js on port 3001)
    handle {
        reverse_proxy frontend:3001
    }
}
